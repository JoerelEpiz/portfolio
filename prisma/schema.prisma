generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id             String   @id @default(cuid())
  name           String
  title          String
  tagline        String
  bio            String
  email          String
  location       String
  availability   Boolean  @default(true)
  yearsExp       Int      @default(0)
  githubUrl      String?
  linkedinUrl    String?
  twitterUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Skill {
  id        String @id @default(cuid())
  name      String
  category  String // "frontend" | "backend" | "database" | "tools"
  level     Int    @default(80) // 0 - 100
  icon      String? // lucide icon name
  sortOrder Int    @default(0)

  @@index([category])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  tags        String[] // PostgreSQL native array
  imageUrl    String?
  liveUrl     String?
  repoUrl     String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  role        String
  description String
  type        String   @default("work") // "work" | "education"
  startDate   DateTime
  endDate     DateTime?
  current     Boolean  @default(false)
  location    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
