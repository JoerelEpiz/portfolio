# PostgreSQL connection string.
# Local Mac (Homebrew PostgreSQL): postgresql://portfolio:portfolio_secret@127.0.0.1:5432/portfolio_db
# Neon/Supabase/managed: paste your connection string here.
DATABASE_URL="postgresql://portfolio:portfolio_secret@127.0.0.1:5432/portfolio_db"

# Same as DATABASE_URL — the app prefers this variable.
POSTGRES_URL="postgresql://portfolio:portfolio_secret@127.0.0.1:5432/portfolio_db"

# Password for the admin dashboard (http://localhost:3000/#admin).
# CHANGE THIS before deploying publicly!
ADMIN_PASSWORD="admin123"
